# Secrets — never commit these.
# .env holds SECRET_KEY, the database password, and the Calendly, Resend
# and (later) Razorpay keys.
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*.so
venv/
.venv/
env/
ENV/

