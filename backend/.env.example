# Copy to .env and fill in. NEVER commit .env itself.

# --- Django ---------------------------------------------------------------
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
DEBUG=False

# Where the React app is served from. Used for links in emails, for
# ALLOWED_HOSTS and as the default CORS origin.
FRONTEND_URL=http://localhost:5173

# --- Database -------------------------------------------------------------
# On Neon, use the DIRECT connection string, not the pooled one. The pooled
# host has "-pooler" in it and runs PgBouncer in transaction mode, which
# breaks session-level features Django relies on.
# Keep ?sslmode=require on the end.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Seconds to keep a database connection open between requests. 0 opens a
# fresh one every request. Connections are health-checked before reuse, so
# a host that suspends an idle database (Neon does, after ~5 minutes) will
# not cause errors.
DB_CONN_MAX_AGE=600

# --- Sign-up email verification -------------------------------------------
# No account is created until the emailed code comes back. These control
# how long someone has and how many guesses they get.
SIGNUP_OTP_LENGTH=6
SIGNUP_OTP_TTL_SECONDS=600
SIGNUP_OTP_MAX_ATTEMPTS=5
SIGNUP_OTP_RESEND_COOLDOWN_SECONDS=60

# --- Security (production) ------------------------------------------------
# Extra hostnames this backend answers on, comma separated.
ALLOWED_HOSTS=
# Browser origins allowed to call the API, comma separated.
# Defaults to FRONTEND_URL when left empty.
CORS_ALLOWED_ORIGINS=
# Turn on only AFTER HTTPS is confirmed working on every subdomain.
# 31536000 is one year. See docs/security.md.
SECURE_HSTS_SECONDS=0

# --- Email (Resend) -------------------------------------------------------
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=Sachfitsin <onboarding@resend.dev>
EMAIL_REPLY_TO=
EMAIL_ENABLED=True
SUPPORT_EMAIL=hello@sachfitsin.com

# --- Calendly -------------------------------------------------------------
CALENDLY_ACCESS_TOKEN=
CALENDLY_WEBHOOK_SIGNING_KEY=
CALENDLY_SYNC_SECRET=

# --- Razorpay -------------------------------------------------------------
# Dashboard -> Settings -> API Keys. Test keys start with rzp_test_.
# Required: the server will not start without these.
# The secret must never be copied into the frontend.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Settings -> Webhooks. Shown once when you create the webhook.
# Until this is set, the webhook endpoint rejects everything.
RAZORPAY_WEBHOOK_SECRET=

# --- Rate limits ----------------------------------------------------------
THROTTLE_ANON=60/min
THROTTLE_USER=240/min
THROTTLE_LOGIN=10/min
THROTTLE_REGISTER=20/hour
